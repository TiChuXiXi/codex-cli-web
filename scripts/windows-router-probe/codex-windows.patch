+#[cfg(windows)]
+fn router_home_path(path: &std::path::Path) -> std::io::Result<std::path::PathBuf> {
+    use std::os::windows::fs::OpenOptionsExt;
+    use std::os::windows::io::AsRawHandle;
+    use std::ffi::c_void;
+    #[link(name = "kernel32")]
+    unsafe extern "system" { fn GetFinalPathNameByHandleW(handle: *mut c_void, out: *mut u16, len: u32, flags: u32) -> u32; }
+    match path.canonicalize() {
+        Ok(value) => Ok(value),
+        Err(original) => {
+            if original.kind()!=std::io::ErrorKind::PermissionDenied {return Err(original);}
+            let expected = std::env::var_os("ZCODEX_HOME_NT").ok_or(original)?;
+            let handle=std::fs::OpenOptions::new().read(true).access_mode(128).custom_flags(0x02000000).open(path)?;
+            let mut name=vec![0u16;32768];
+            let len=unsafe{ GetFinalPathNameByHandleW(handle.as_raw_handle(),name.as_mut_ptr(),name.len() as u32,2) } as usize;
+            use std::os::windows::ffi::OsStringExt;
+            if len==0 || len>=name.len() || std::ffi::OsString::from_wide(&name[..len])!=expected {
+                return Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied,"Router home directory identity did not match its supervisor"));
+            }
+            Ok(path.to_owned())
+        }
+    }
+}
+#[cfg(not(windows))]
+fn router_home_path(path: &std::path::Path) -> std::io::Result<std::path::PathBuf> {path.canonicalize()}
