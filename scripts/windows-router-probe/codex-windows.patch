+// LPAC can query an opened file's NT name even when DOS drive resolution is denied.
+#[cfg(windows)]
+fn canonicalize_rollout(path: &std::path::Path, home: &std::path::Path) -> std::io::Result<std::path::PathBuf> {
+    use std::os::windows::ffi::OsStrExt;
+    use std::os::windows::fs::OpenOptionsExt;
+    use std::os::windows::io::AsRawHandle;
+    use std::path::{Component, PathBuf};
+
+    let original = match std::fs::canonicalize(path) {
+        Err(e) if e.kind() == std::io::ErrorKind::PermissionDenied => e,
+        other => return other,
+    };
+    let Some(nt_home) = std::env::var_os("ZCODEX_HOME_NT") else { return Err(original) };
+    let Ok(relative) = path.strip_prefix(home) else { return Err(original) };
+    if !(relative.starts_with("sessions") || relative.starts_with("archived_sessions"))
+        || relative.components().any(|part| !matches!(part, Component::Normal(_))) {
+        return Err(original);
+    }
+    let expected: Vec<u16> = PathBuf::from(nt_home).join(relative).as_os_str().encode_wide().collect();
+    let file = std::fs::OpenOptions::new().read(true).access_mode(0x80).open(path)?;
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn GetFinalPathNameByHandleW(handle: *mut std::ffi::c_void, name: *mut u16, size: u32, flags: u32) -> u32;
+    }
+    let mut name = vec![0u16; 32768];
+    // VOLUME_NAME_NT | FILE_NAME_NORMALIZED. Reject redirections outside the verified home.
+    let len = unsafe { GetFinalPathNameByHandleW(file.as_raw_handle(), name.as_mut_ptr(), name.len() as u32, 2) } as usize;
+    if len == 0 || len >= name.len() || name[..len] != expected { return Err(original); }
+    Ok(path.to_owned())
+}
+
+#[cfg(not(windows))]
+fn canonicalize_rollout(path: &std::path::Path, _home: &std::path::Path) -> std::io::Result<std::path::PathBuf> {
+    std::fs::canonicalize(path)
+}
