{
  "name": "codex-cli-web",
  "version": "0.1.0",
  "description": "Standalone Codex CLI web workbench",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "codex-web-ui": "bin/codex-web-ui.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "dist/web",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "vendor/dsh-dockkit/LICENSE",
    "vendor/dsh-dockkit/PROVENANCE.md",
    "docs/REFERENCE_BASELINE.md",
    "docs/ROUTER.md",
    "docs/acceptance/router-a1.md",
    "docs/acceptance/router-a2.md",
    "scripts/prepare-router-codex.mjs",
    "scripts/router-launcher.sh"
  ],
  "scripts": {
    "start": "node bin/codex-web-ui.mjs",
    "dev": "npm run build && npm start",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test",
    "test:live": "node scripts/test-live.mjs",
    "prepack": "npm run build",
    "test:parity": "node scripts/test-parity.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.70.0",
    "mermaid": "11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
